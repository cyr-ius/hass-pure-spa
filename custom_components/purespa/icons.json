{
  "entity": {
    "select": {
      "temperature_unit": {
        "default": "mdi:thermometer",
        "state": {
          "celsius": "mdi:temperature-celsius",
          "fahrenheit": "mdi:temperature-fahrenheit"
        }
      }
    },
    "sensor": {
      "error": {
        "default": "mdi:alert-circle-outline"
      },
      "filter_timer": {
        "default": "mdi:timer-outline"
      },
      "sanitizer_timer": {
        "default": "mdi:timer-outline"
      },
      "heater_timer": {
        "default": "mdi:timer-outline"
      },
      "heater_delay": {
        "default": "mdi:timer-sand"
      }
    },
    "switch": {
      "power": {
        "default": "mdi:power"
      },
      "filter": {
        "default": "mdi:air-filter"
      },
      "jets": {
        "default": "mdi:waves"
      },
      "bubbles": {
        "default": "mdi:chart-bubble"
      },
      "sanitizer": {
        "default": "mdi:shield-check-outline"
      }
    }
  },
  "services": {
    "set_timer": {
      "service": "mdi:timer-play-outline"
    },
    "clear_timer": {
      "service": "mdi:timer-off-outline"
    }
  }
}
